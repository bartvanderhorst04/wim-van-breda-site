@media (max-width:1000px){[data-delivgrid]{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
/* Definitieve kaartcorrectie: gelijke machine-/occasionkaarten, centrale bron
   van waarheid voor kaartbreedte, kaarthoogte, afbeeldingsvlak, tekstzones
   en footerpositie. Vaste totale kaarthoogte (niet alleen height:100%),
   zodat kaarten ook tussen verschillende rijen exact gelijk zijn. */
:root{--wvb-ch:560px;--wvb-cih:210px}
[data-mgrid]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:var(--wvb-ch);gap:24px}
.wvb-card{width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#fff;border:1px solid #E6E3DD;border-radius:2px;padding:0;text-align:left;cursor:pointer;display:grid;grid-template-rows:var(--wvb-cih) 1fr;transition:transform .28s cubic-bezier(.2,.7,.3,1),box-shadow .28s,border-color .28s}
.wvb-card__img{width:100%;height:100%;min-height:0;overflow:hidden;box-sizing:border-box;display:flex;align-items:center;justify-content:center;padding:16px;position:relative}
.wvb-card__img img,.wvb-card__img image-slot{display:block;width:100%;height:100%}
.wvb-card__body{min-height:0;overflow:hidden;display:flex;flex-direction:column;padding:24px;box-sizing:border-box}
.wvb-card__brand{flex:0 0 auto;font:500 11px/16px 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#8C867A}
.wvb-card__title{flex:0 0 auto;font:600 19px/1.25 Archivo,sans-serif;margin:10px 0 0;min-height:calc(1.25em*3);max-height:calc(1.25em*3);overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3}
.wvb-card__cat{flex:0 0 auto;font:400 14px/1.5 'IBM Plex Sans',sans-serif;color:#7C7770;margin-top:8px;min-height:calc(1.5em*2);max-height:calc(1.5em*2);overflow:hidden}
.wvb-card__meta{flex:0 0 auto;min-height:28px;margin-top:14px;display:flex;align-items:center;gap:9px}
.wvb-card__spacer{flex:1 1 auto;min-height:0}
.wvb-card__footer{flex:0 0 auto;margin-top:22px;padding-top:18px;border-top:1px solid #F1EFEA;display:flex;align-items:center;justify-content:space-between}
@media (max-width:760px){[data-mgrid]{grid-template-columns:1fr}}

/* Homepage "Machines uit ons aanbod": drie identieke, even hoge kaarten. Het
   afbeeldingsvak krijgt een vaste aspect-ratio (geen vaste pixelwaarde nodig)
   — bij drie gelijke kolombreedtes levert dat vanzelf drie gelijke
   beeldhoogtes op; de tekstzones eronder hebben elk hun eigen vaste,
   inhoudsonafhankelijke hoogte, dus de totale kaarthoogte komt bij alle drie
   automatisch overeen, zonder een geraden minimumhoogte te forceren. */
.wvb-feat-card{width:100%;height:100%;box-sizing:border-box;overflow:hidden;background:#fff;display:flex;flex-direction:column}
.wvb-feat-card__img{width:100%;aspect-ratio:3/2;flex:0 0 auto;overflow:hidden;box-sizing:border-box;background:#f3f3f1;display:flex;align-items:center;justify-content:center;position:relative}
.wvb-feat-card__img img,.wvb-feat-card__img image-slot{display:block;width:100%;height:100%}
.wvb-feat-card__body{min-height:0;flex:1 1 auto;display:flex;flex-direction:column;padding:24px 24px 26px;box-sizing:border-box}
.wvb-feat-card__brand{flex:0 0 auto;min-height:14px;line-height:14px;font:500 11px/14px 'IBM Plex Mono',monospace;letter-spacing:.16em;text-transform:uppercase;color:#8C867A}
.wvb-feat-card__title{flex:0 0 auto;font:600 19px/1.25 Archivo,sans-serif;margin:10px 0 0;min-height:calc(1.25em*2);max-height:calc(1.25em*2);overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.wvb-feat-card__cat{flex:0 0 auto;min-height:20px;line-height:20px;margin-top:8px;overflow:hidden;font:400 14px/1.5 'IBM Plex Sans',sans-serif;color:#7C7770}
.wvb-feat-card__spacer{flex:1 1 auto;min-height:0}
.wvb-feat-card__footer{flex:0 0 auto;margin-top:22px;padding-top:18px;border-top:1px solid #F1EFEA;display:flex;align-items:center;justify-content:space-between}
@media (max-width:620px){[data-delivgrid]{grid-template-columns:1fr!important}[data-delivfilters]{flex-wrap:nowrap!important;overflow-x:auto;padding-bottom:6px}}
@media (max-width:1000px){[data-maggrid]{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:26px!important}}
@media (max-width:620px){[data-maggrid]{grid-template-columns:1fr!important}}
@media (max-width:700px){[data-carousel] button[aria-label="Vorige afbeelding"],[data-carousel] button[aria-label="Volgende afbeelding"]{width:38px!important;height:38px!important;left:10px}[data-carousel] button[aria-label="Volgende afbeelding"]{left:auto;right:10px}}
@media (max-width:980px){[data-svshops]{grid-template-columns:1fr!important}}
@media (max-width:700px){[data-usp]{gap:8px 20px!important}[data-usp]>span{font-size:14px!important}}
@media (max-width:620px){[data-routes]{grid-template-columns:1fr!important}[data-featured]{grid-template-columns:1fr!important}}
@media (min-width:981px){[data-ck]{flex-direction:column}}
@media (max-width:980px){[data-ck]>button{flex:1 1 auto;padding:13px 16px!important;text-align:center!important}
[data-desk]{display:none!important}[data-mob]{display:inline-flex!important}[data-split]{grid-template-columns:1fr!important}[data-side]{position:static!important;width:100%!important}}
