      },
      homeSearchLabel,
      applyHomeSearch: ()=>this.nav('machines',null,{ftype: s.homeType?[s.homeType]:[], fbrand: s.homeBrand?[s.homeBrand]:[]}),

      // Galerijslots zijn per machine uniek: dg-<machine-id>-<n>. Zo kan een foto van
      // machine A nooit op machine B verschijnen. galTotal komt uit het machine-object.
      galSlot: (detailRaw?detailRaw.id:'none')+'-'+(Math.min(s.gallery,Math.max(galCount,1)-1)+1),
      galPos: s.gallery+1,
      galLabel: (detailRaw ? this.displayName(detailRaw)+' — foto ' : 'Machinefoto ')+(Math.min(s.gallery,Math.max(galCount,1)-1)+1),
      galTotal: galCount,
      galMulti: galCount>1, galHasThumbs: false,
      // Geen enkele echte foto beschikbaar (data of admin-slots) → de hele
