  // Fotografie per machine komt uit machine-images.js, gekoppeld op slug.
  // Ontbreekt de slug daar, dan valt hij terug op m.images en anders op 0 foto's.
  photosFor(m){
    if (!m) return [];
    const map = (typeof window !== 'undefined' && window.MACHINE_IMAGES) || {};
    const fromFile = map[m.slug] || map[m.id];
