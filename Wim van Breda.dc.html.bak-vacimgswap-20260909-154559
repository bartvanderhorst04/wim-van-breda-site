      setQMsg: (e)=>this.setState({qMsg:e.target.value}),
      qNext: ()=>this.setState({qStep:3}),
      qBack: ()=>this.setState({qStep:Math.max(1,s.qStep-1)}),
      setQName: (e)=>this.setState({qName:e.target.value}),
      setQContact: (e)=>this.setState({qContact:e.target.value}),
      qBusy: !!s.qBusy, qError: s.qError, qHasError: !!s.qError,
      qBtnLabel: s.qBusy ? 'Versturen…' : 'Versturen',
      qSubmit: ()=>this.wizardSend(),
      qReset: ()=>this.setState({qStep:1,qTopic:'',qMsg:''}),

      seoT: s.seoT, seoD: s.seoD,
      seoTLen: s.seoT.length, seoDLen: s.seoD.length,
      seoTColor: (s.seoT.length>60||s.seoT.length<30) ? '#E1021D' : '#4A7A3A',
      seoDColor: (s.seoD.length>160||s.seoD.length<120) ? '#E1021D' : '#4A7A3A',
      setSeoT: (e)=>this.setState({seoT:e.target.value}),
