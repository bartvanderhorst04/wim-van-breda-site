      goMerken: ()=>this.nav('merken'),
      goContact: ()=>{
        const m = this.meta();
        if (page==='detail' && detailRaw){
          const type = s.rentalFrom ? 'verhuur' : (detailRaw.isOccasion ? 'occasion' : 'machine');
