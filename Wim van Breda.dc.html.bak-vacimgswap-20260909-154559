      isRentalDetail: !!s.rentalFrom,
      isSalesDetail: !s.rentalFrom,
      openAanbod: ()=>this.setState({menu:'aanbod'}),
      tabMachines: ()=>this.setTab('machines'),
      tabMerken: ()=>this.setTab('merken'),
      tabVerhuur: ()=>this.setTab('verhuur'),
      tabIsMachines: s.menuTab==='machines', tabIsMerken: s.menuTab==='merken', tabIsVerhuur: s.menuTab==='verhuur',
      tabNact: s.menuTab==='machines' ? '1' : '0',
      tabMact: s.menuTab==='merken' ? '1' : '0',
      tabVact: s.menuTab==='verhuur' ? '1' : '0',
      tabNbc: s.menuTab==='machines' ? '#C00020' : 'transparent',
      tabMbc: s.menuTab==='merken' ? '#C00020' : 'transparent',
      tabVbc: s.menuTab==='verhuur' ? '#C00020' : 'transparent',
      topBrands: Component.TOP_BRANDS.map(n=>{
        const b = Component.BRANDS.find(x=>x.name===n);
        return {name:n, open: ()=> b ? this.nav('merk',b.id) : this.nav('merken')};
      }),
      rentalCats: Component.RENTAL.map(c=>Object.assign({},c,{open: ()=>this.nav('verhuur',c.id)})),
      closeMenu: ()=>this.setState({menu:null}),
      toggleMob: ()=>this.setState({mob:!s.mob}),

      hoverIn:this.hoverIn, hoverOut:this.hoverOut, btnIn:this.btnIn, btnOut:this.btnOut,
      navIn:this.navIn, navOut:this.navOut, rowIn:this.rowIn, rowOut:this.rowOut,
      chipIn:this.chipIn, chipOut:this.chipOut, fieldIn:this.fieldIn, fieldOut:this.fieldOut,
      ftIn:this.ftIn, ftOut:this.ftOut,

      // Uitgelichte machines op de homepage — vaste selectie op machine-id
      featured: ['raymo-torpedo-werktuigdrager','herder-grenadier-maaiarm','kersten-planierhobel-egaliseermachine']
