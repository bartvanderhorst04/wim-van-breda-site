      galSlideWFull: '100%',
      galShiftFull: 'calc(' + (-galIdx * 100) + '% + ' + (s.galDrag||0) + 'px)',
      galEase: s.galDragging ? 'none' : 'transform .45s cubic-bezier(.22,.7,.28,1)',
      galGrab: galCount>1 ? (s.galDragging ? 'grabbing' : 'grab') : 'default',
      slides: Array.from({length:Math.max(galCount,1)},(_,i)=>({
        fromData: !!(photos[i] && photos[i].src),
        fromSlot: !(photos[i] && photos[i].src),
        imgEl: this.photoEl(photos[i], detailRaw ? this.displayName(detailRaw)+' — foto '+(i+1) : '', Object.assign({fit:'natural', maxHeight:'640px'}, i===galIdx ? {priority:'high'} : {lazy:true})),
        slot: (detailRaw?detailRaw.id:'none')+'-'+(i+1),
        label: (photos[i] && photos[i].alt) ? photos[i].alt : ((detailRaw ? this.displayName(detailRaw)+' — ' : '')+'foto '+(i+1))
      })),
      dots: Array.from({length:galCount},(_,i)=>({
        active: i===galIdx,
        w: i===galIdx ? '26px' : '8px',
        bg: i===galIdx ? '#FBAE00' : '#D9D5CD',
        label: 'Toon afbeelding '+(i+1),
        go: ()=>this.setState({gallery:i})
      })),
      arrIn: (e)=>{ e.currentTarget.style.background='#FBAE00'; },
      arrOut: (e)=>{ e.currentTarget.style.background='rgba(255,255,255,.94)'; },
      galDown: (e)=>{ if(galCount<2) return; this._dragX=e.clientX; this._dragW=e.currentTarget.offsetWidth||1; e.currentTarget.setPointerCapture&&e.currentTarget.setPointerCapture(e.pointerId); this.setState({galDragging:true, galDrag:0}); },
      galMove: (e)=>{ if(!this.state.galDragging) return; this.setState({galDrag: e.clientX - this._dragX}); },
      galUp: (e)=>{
        if(!this.state.galDragging) return;
        const dx = this.state.galDrag||0;
        const threshold = Math.max(48, (this._dragW||400)*0.14);
        this.setState({galDragging:false, galDrag:0});
        if (dx <= -threshold) this.galStep(1);
        else if (dx >= threshold) this.galStep(-1);
      },
      // Thumbnailrij: alle foto's, horizontaal scrollbaar; de actieve krijgt een rustige rand.
      thumbs: Array.from({length:galCount},(_,i)=>({
        active: i===galIdx,
        fromData: !!(photos[i] && photos[i].src),
        fromSlot: !(photos[i] && photos[i].src),
        imgEl: this.photoEl(photos[i], detailRaw ? this.displayName(detailRaw)+' — foto '+(i+1) : '', {lazy:true}),
        pickLabel: 'Toon foto '+(i+1)+' als hoofdafbeelding',
        slot: (detailRaw?detailRaw.id:'none')+'-'+(i+1),
        label: (photos[i] && photos[i].alt) ? photos[i].alt : ((detailRaw ? this.displayName(detailRaw)+' — ' : '')+'foto '+(i+1)),
        border: i===galIdx ? '2px solid #FBAE00' : '1px solid #E6E3DD',
        pick: ()=>this.setState({gallery:i})
      })),
      // Zonder foto's is er niets te vergroten: geen zoomdoel, geen overlay, geen teller.
      openLightbox: ()=>{ if(galCount>0) this.setState({lightbox:true}); },
      closeLightbox: ()=>this.setState({lightbox:false}),
      lightbox: s.lightbox && galCount>0,
      galCursor: galCount>0 ? 'zoom-in' : 'default',
      galBtnLabel: galCount>0 ? 'Vergroot afbeelding' : 'Machinefoto',
      galSingle: galCount<=1,
      galMinReached: galCount<=1,
      galAdd: ()=>{ if(detailRaw){ const n=galCount+1; this.setSlotCount(detailRaw.id, n); this.setState({gallery:n-1}); } },
      galRemove: ()=>{ if(detailRaw && galCount>1) this.setSlotCount(detailRaw.id, galCount-1); },
      ovIn: (e)=>{ e.currentTarget.style.background='#FBAE00'; e.currentTarget.style.color='#111214'; },
      ovOut: (e)=>{ e.currentTarget.style.background='rgba(17,18,20,.72)'; e.currentTarget.style.color='#fff'; },
      galFromData: !!(curPhoto && curPhoto.src),
      galFromSlot: !(curPhoto && curPhoto.src),
      galImgEl: this.photoEl(curPhoto, detailRaw ? this.displayName(detailRaw) : '', {priority:'high'}),
      galLbImgEl: this.photoEl(curPhoto, detailRaw ? this.displayName(detailRaw) : '', {fit:'contain'}),
      galPrev: ()=>this.galStep(-1),
      galNext: ()=>this.galStep(1),
      galIn:this.galIn, galOut:this.galOut,

      detail: detailRaw ? Object.assign(this.deco(detailRaw), {
        voordelen: (detailRaw.kenmerken||[]).concat([
          'Onderdelen op voorraad in Geldermalsen',
          'Onderhoud en reparatie in eigen werkplaats',
          'Advies op locatie voor de juiste uitvoering'
        ]).slice(0,6).map((t,i)=>({n:String(i+1).padStart(2,'0'), t}))
      }) : {},
      // Gerelateerd: eerst zelfde type, dan zelfde merk, dan zelfde toepassing. Nooit zichzelf.
      related: detailRaw ? (()=>{
        const pool = (detailRaw.isOccasion ? Component.publishedOcc() : Component.published()).filter(m=>m.id!==detailRaw.id);
        const rank = m => (m.type===detailRaw.type ? 0 : (m.brand===detailRaw.brand ? 1 : 2));
        return pool.filter(m=>rank(m)<2).sort((a,b)=>rank(a)-rank(b)).slice(0,3).map(m=>this.deco(m));
      })() : [],
      detailToepassingen: detailRaw ? (this.deco(detailRaw).toepassingen||[]).map(t=>({label:t, go: ()=>this.nav('machines',null,{q:t})})) : [],
      goDetailType: ()=>{ if(detailRaw) this.nav(detailRaw.isOccasion?'occasions':'machines',null,{ftype:[detailRaw.type]}); },
      goDetailBrand: ()=>{ if(!detailRaw) return; const b=Component.BRANDS.find(x=>x.name===detailRaw.brand); if(b) this.nav('merk',b.id); else this.nav('machines',null,{fbrand:[detailRaw.brand]}); },
      crumbOut: (e)=>{ e.currentTarget.style.color='#8C867A'; },

      brand: brand || {},
      brandSlotId: brand ? brand.id : 'none',
      brandMachineCount: brand ? Component.published().filter(m=>m.brand===brand.name).length : 0,
      brandResults, brandCount: brandResults.length,
      // CMS: homepage_featured_brands — exact 3 gekozen merken, geen automatische top-3
      featuredBrands: (this.props.featuredBrands || ['herder','greentec','reform'])
        .map(id=>Component.BRANDS.find(b=>b.id===id))
        .filter(Boolean)
        .map(b=>({id:b.id, name:b.name, intro:b.intro,
          open: ()=>this.nav('merk', b.id)})),
      merkPaged, merkResultCount: res.length, merkNoun: res.length===1?'machine':'machines',
      merkEmpty: res.length===0, merkHasPages: totalPages>1, merkPageLinks,
      merkPrevDis: bp<=1, merkNextDis: bp>=totalPages,
      merkPrev: ()=>this.setState({bpage:Math.max(1,bp-1)}),
      merkNext: ()=>this.setState({bpage:Math.min(totalPages,bp+1)}),
      merkRangeLabel: res.length ? ((bp-1)*10+1)+'–'+Math.min(bp*10,res.length)+' van '+res.length : '0',
      seoH2a: brand ? 'Over '+brand.name : '',
      seoH2b: brand ? brand.name+' machines voor professioneel gebruik' : '',
      seoH2c: brand ? 'Waarom '+brand.name+' via Wim van Breda' : '',
      seoP1: brand ? brand.tekst+' Wim van Breda levert '+brand.name+' in Nederland en combineert de levering met eigen advies, onderhoud en onderdelenvoorziening. Onze verkopers kennen de machines uit de praktijk en bekijken samen met u welke uitvoering past bij uw werk, uw trekker of kraan en de omstandigheden waarin u werkt.' : '',
      seoP2: brand ? 'Het '+brand.name+'-programma bij Wim van Breda bestaat uit machines voor professioneel groen- en terreinbeheer. Hieronder vindt u het actuele aanbod, te filteren op machinetype. Staat de uitvoering die u zoekt er niet tussen? Veel machines zijn in meerdere werkbreedtes en aandrijvingen leverbaar; neem contact op voor de mogelijkheden.' : '',
      seoP3: brand ? 'Wij zijn meer dan leverancier. Onze werkplaats in Geldermalsen verzorgt onderhoud, reparatie en garantie op '+brand.name+'-machines, ons magazijn houdt de veelgevraagde onderdelen op voorraad en onze servicemonteurs komen bij u op locatie wanneer een machine stilstaat. Zo blijft uw machinepark draaien, ook in het seizoen.' : '',
      seoTags: brand ? ['Bermonderhoud','Slootonderhoud','Terreinbeheer','Groenbeheer','Tuin en park'] : [],

      hours: Component.HOURS,
      deptTabs: Component.DEPTS.map(name=>({name,
        bg: s.dept===name ? '#FBAE00' : '#ffffff',
        bc: s.dept===name ? '#000000' : '#D9D5CD',
        on: ()=>this.setState({dept:name})})),
      people: Component.PEOPLE.filter(p=>p.afdeling===s.dept),
      tabIn:this.tabIn, tabOut:this.tabOut, ddIn:this.ddIn, ddOut:this.ddOut,
      tabMachinesHover: (e)=>{ this.ddIn(e); this.setState({menuTab:'machines'}); },
      tabMerkenHover: (e)=>{ this.ddIn(e); this.setState({menuTab:'merken'}); },
      tabVerhuurHover: (e)=>{ this.ddIn(e); this.setState({menuTab:'verhuur'}); },

      qProgress: s.qStep>=4 ? 1 : (s.qStep/3),
      qLabel: s.qStep>=4 ? 'Verzonden' : ('Stap '+s.qStep+' van 3'),
      qStep1: s.qStep===1, qStep2: s.qStep===2, qStep3: s.qStep===3, qDone: s.qStep>=4,
      qTopic: s.qTopic || 'Anders',
      topics: Component.TOPICS.map(name=>{
        const on = s.qTopic===name;
        return {name, bg: on?'#FBAE00':'#ffffff', bc: on?'#FBAE00':'#C9C4BA', on: ()=>this.setState({qTopic:name,qStep:2})};
