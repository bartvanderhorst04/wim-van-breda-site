  glide(el,to){
    if(!el) return;
    const max = el.scrollWidth - el.clientWidth;
    const target = Math.max(0, Math.min(max, to));
    clearInterval(el._tw);
    const from = el.scrollLeft, d = target - from;
    el.scrollLeft = target;
    if (this.reduced() || d === 0) return;
    const t0 = Date.now(), dur = 360;
    el.scrollLeft = from;
    el._tw = setInterval(()=>{
      const p = Math.min(1, (Date.now() - t0)/dur);
      el.scrollLeft = from + d * (1 - Math.pow(1-p, 3));
      if (p >= 1){ clearInterval(el._tw); el.scrollLeft = target; this.forceUpdate(); }
