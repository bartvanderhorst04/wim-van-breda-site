/* Responsive: contentcontainers houden op smalle schermen een compacte marge
   in plaats van de desktopwaarde van 40-70px. Alleen horizontaal; verticale
   ritmiek en desktoplayout blijven ongemoeid. */
@media (max-width:900px){
  [style*="max-width: 1420px"],[style*="max-width: 1360px"],[style*="max-width: 1180px"],[style*="max-width:1420px"],[style*="max-width:1360px"],[style*="max-width:1180px"]{padding-left:32px!important;padding-right:32px!important}
}
@media (max-width:620px){
  [style*="max-width: 1420px"],[style*="max-width: 1360px"],[style*="max-width: 1180px"],[style*="max-width:1420px"],[style*="max-width:1360px"],[style*="max-width:1180px"]{padding-left:20px!important;padding-right:20px!important}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</helmet>

<div style="min-height:100vh;display:flex;flex-direction:column;background:#FCFCFB url(./assets/bg-diagonaal.png) no-repeat center center/cover;background-image:image-set(url(./assets/bg-diagonaal-opt.webp) type('image/webp'), url(./assets/bg-diagonaal.png) type('image/png'));background-repeat:no-repeat;background-position:center center;background-size:cover;background-attachment:fixed">

<sc-if value="{{ transit }}" hint-placeholder-val="{{ false }}">
  <div aria-hidden="true" style="position:fixed;inset:0;z-index:9000;background:#ffffff;pointer-events:none;animation:wvbLayer 780ms cubic-bezier(.4,0,.2,1) forwards;overflow:hidden">
    <div style="position:absolute;top:calc(50% + 26px);left:0;right:0;height:2px;background:#FBAE00;transform-origin:left;animation:wvbTrail 700ms cubic-bezier(.3,0,.2,1) forwards"></div>
    <img src="./assets/tractor-opt.png" alt="" width="158" height="160" decoding="async" style="position:absolute;top:50%;left:0;width:76px;height:76px;margin-top:-52px;animation:wvbDrive 780ms cubic-bezier(.35,0,.25,1) forwards">
  </div>
</sc-if>

<header ref="{{ hdrRef }}" style="position:sticky;top:0;z-index:800;padding:0;transition:padding .34s cubic-bezier(.22,.7,.28,1)">
  <div style="max-width:100%;margin:0 auto;padding:0;position:relative">
  <div ref="{{ barRef }}" style="position:relative;height:84px;transition:height .34s cubic-bezier(.22,.7,.28,1),transform .34s cubic-bezier(.22,.7,.28,1)">
    <span aria-hidden="true" ref="{{ shapeRef }}" style="position:absolute;inset:0;background:#FBAE00;border-bottom:1px solid #C00020;box-shadow:0 18px 40px -32px rgba(17,18,20,.34);transition:box-shadow .34s"></span>
    <div data-hdrinner="" style="position:relative;height:100%;max-width:1360px;margin:0 auto;padding:0 40px;display:flex;align-items:center;justify-content:space-between;gap:40px">
    <a href="#home" onClick="{{ goHome }}" aria-label="Wim van Breda — home" style="position:relative;display:flex;align-items:center;flex:0 0 auto">
      <img ref="{{ logoRef }}" src="./assets/wvb-logo.svg" alt="Wim van Breda — Bewuste vooruitgang" style="height:60px;width:auto;object-fit:contain;display:block;transition:height .28s cubic-bezier(.2,.7,.3,1)">
    </a>

    <nav data-desk="" style="position:relative;align-self:stretch;display:flex;align-items:center;gap:6px">
      <div onMouseEnter="{{ openAanbod }}" onMouseLeave="{{ closeMenu }}" style="position:relative;align-self:stretch;display:flex;align-items:center">
        <button onClick="{{ goMachines }}" style="background:none;border:0;cursor:pointer;padding:10px 16px;font:500 17px/1 'IBM Plex Sans',sans-serif;color:#000000;display:flex;align-items:center;gap:8px">
          Aanbod
          <span style="width:5px;height:5px;border-right:1.5px solid rgba(0,0,0,.55);border-bottom:1.5px solid rgba(0,0,0,.55);transform:rotate(45deg);margin-top:-3px"></span>
        </button>
        <sc-if value="{{ menuAanbod }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute;top:100%;left:-16px;padding-top:1px;animation:wvbDrawer .2s cubic-bezier(.2,.7,.3,1) both">
            <div style="width:560px;background:#FBAE00;box-shadow:0 10px 30px rgba(0,0,0,.08);display:grid;grid-template-columns:42% 58%;overflow:hidden">
              <div style="padding:18px 14px;display:flex;flex-direction:column;gap:0;border-right:1px solid rgba(0,0,0,.12)">
                <button data-active="{{ tabNact }}" onClick="{{ goMachines }}" onMouseEnter="{{ tabMachinesHover }}" onMouseLeave="{{ ddOut }}" style="text-align:left;background:transparent;border:0;border-left:2px solid {{ tabNbc }};cursor:pointer;padding:11px 13px 11px 11px;display:flex;flex-direction:column;gap:3px;transition:background .2s">
                  <span style="display:flex;align-items:center;justify-content:space-between;gap:10px;font:600 15px/1 'IBM Plex Sans',sans-serif;color:#000">Nieuwe machines<span data-ddarrow="" style="opacity:1;transition:transform .2s cubic-bezier(.2,.7,.3,1),color .2s ease">→</span></span>
                  <span data-ddsub="" style="font:400 12px/1.45 'IBM Plex Sans',sans-serif;color:rgba(0,0,0,.62)">Actueel aanbod, filterbaar op type en merk</span>
                </button>
                <button data-active="{{ tabMact }}" onClick="{{ goMerken }}" onMouseEnter="{{ tabMerkenHover }}" onMouseLeave="{{ ddOut }}" style="text-align:left;background:transparent;border:0;border-left:2px solid {{ tabMbc }};cursor:pointer;padding:11px 13px 11px 11px;display:flex;flex-direction:column;gap:3px;transition:background .2s">
                  <span style="display:flex;align-items:center;justify-content:space-between;gap:10px;font:600 15px/1 'IBM Plex Sans',sans-serif;color:#000">Merken<span data-ddarrow="" style="opacity:1;transition:transform .2s cubic-bezier(.2,.7,.3,1),color .2s ease">→</span></span>
                  <span data-ddsub="" style="font:400 12px/1.45 'IBM Plex Sans',sans-serif;color:rgba(0,0,0,.62)">De merken waarmee wij samenwerken</span>
                </button>
                <button data-active="{{ tabVact }}" onClick="{{ goVerhuur }}" onMouseEnter="{{ tabVerhuurHover }}" onMouseLeave="{{ ddOut }}" style="text-align:left;background:transparent;border:0;border-left:2px solid {{ tabVbc }};cursor:pointer;padding:11px 13px 11px 11px;display:flex;flex-direction:column;gap:3px;transition:background .2s">
                  <span style="display:flex;align-items:center;justify-content:space-between;gap:10px;font:600 15px/1 'IBM Plex Sans',sans-serif;color:#000">Verhuur<span data-ddarrow="" style="opacity:1;transition:transform .2s cubic-bezier(.2,.7,.3,1),color .2s ease">→</span></span>
                  <span data-ddsub="" style="font:400 12px/1.45 'IBM Plex Sans',sans-serif;color:rgba(0,0,0,.62)">Machines huren voor tijdelijke inzet</span>
                </button>
              </div>
              <div style="padding:18px 20px;display:flex;flex-direction:column;justify-content:space-between;gap:14px;min-height:214px">
                <sc-if value="{{ tabIsMachines }}" hint-placeholder-val="{{ true }}">
                  <div style="display:flex;flex-direction:column;gap:18px;animation:wvbSwap .24s cubic-bezier(.2,.7,.3,1) both">
                    <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:rgba(0,0,0,.74)">Uitgelichte machinetypes</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 16px">
                      <sc-for list="{{ menuTypeOpts }}" as="t" hint-placeholder-count="6">
                        <button onClick="{{ t.quick }}" onMouseEnter="{{ ddIn }}" onMouseLeave="{{ ddOut }}" style="display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;background:none;border:0;padding:8px 8px 8px 6px;margin:0 -6px;cursor:pointer;font:500 14px/1.3 'IBM Plex Sans',sans-serif;color:#000;transition:background .2s">
                          {{ t.name }}
                          <span data-ddarrow="" style="opacity:1;transition:transform .2s cubic-bezier(.2,.7,.3,1),color .2s ease">→</span>
                        </button>
                      </sc-for>
                    </div>
                    <button data-active="{{ tabNact }}" onClick="{{ goMachines }}" onMouseEnter="{{ btnIn }}" onMouseLeave="{{ btnOut }}" style="margin-top:auto;align-self:flex-start;background:#111214;color:#fff;border:0;padding:11px 16px;font:600 12px/1 'IBM Plex Sans',sans-serif;cursor:pointer;display:inline-flex;gap:9px;align-items:center;transition:all .22s">
                      Bekijk alle nieuwe machines <span data-arrow="" style="transition:transform .24s cubic-bezier(.2,.7,.3,1)">→</span>
                    </button>
                  </div>
                </sc-if>
                <sc-if value="{{ tabIsMerken }}" hint-placeholder-val="{{ false }}">
                  <div style="display:flex;flex-direction:column;gap:18px;animation:wvbSwap .24s cubic-bezier(.2,.7,.3,1) both">
                    <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:rgba(0,0,0,.74)">Uitgelichte merken</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 16px">
                      <sc-for list="{{ topBrands }}" as="b" hint-placeholder-count="6">
                        <button onClick="{{ b.open }}" onMouseEnter="{{ ddIn }}" onMouseLeave="{{ ddOut }}" style="display:flex;align-items:center;justify-content:space-between;gap:10px;text-align:left;background:none;border:0;padding:8px 8px 8px 6px;margin:0 -6px;cursor:pointer;font:500 14px/1.3 'IBM Plex Sans',sans-serif;color:#000;transition:background .2s">
                          {{ b.name }}
                          <span data-ddarrow="" style="opacity:1;transition:transform .2s cubic-bezier(.2,.7,.3,1),color .2s ease">→</span>
                        </button>
                      </sc-for>
                    </div>
                    <button data-active="{{ tabMact }}" onClick="{{ goMerken }}" onMouseEnter="{{ btnIn }}" onMouseLeave="{{ btnOut }}" style="margin-top:auto;align-self:flex-start;background:#111214;color:#fff;border:0;padding:11px 16px;font:600 12px/1 'IBM Plex Sans',sans-serif;cursor:pointer;display:inline-flex;gap:9px;align-items:center;transition:all .22s">
                      Bekijk alle merken <span data-arrow="" style="transition:transform .24s cubic-bezier(.2,.7,.3,1)">→</span>
                    </button>
                  </div>
                </sc-if>
                <sc-if value="{{ tabIsVerhuur }}" hint-placeholder-val="{{ false }}">
                  <div style="display:flex;flex-direction:column;gap:18px;animation:wvbSwap .24s cubic-bezier(.2,.7,.3,1) both">
