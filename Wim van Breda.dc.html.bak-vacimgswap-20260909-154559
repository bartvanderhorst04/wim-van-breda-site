      // De brede "in bedrijf"-afbeelding is een los in te vullen beeldvlak (image-slot).
      // Er is hiervoor nog bij geen enkele machine of occasion een foto aangeleverd —
      // toon het blok dus pas zodra dat wél zo is, anders blijft er een leeg vlak met
      // ontbrekend-afbeelding-icoon staan.
      hasWideImg: false,
      open: ()=>this.nav('detail',m.id,rentalFrom ? {rentalFrom} : {rentalFrom:null})
    });
  }

  renderVals(){
    const s = this.state, page = s.page;
    const res = (page==='machines'||page==='occasions'||page==='merk'||page==='verhuur') ? this.results() : [];
    const detailRaw = this.findItem(s.param);
    const photos = this.livePhotos(detailRaw);
    const galCount = this.slotCountFor(detailRaw);
    const galIdx = Math.min(s.gallery, Math.max(galCount,1)-1);
    const curPhoto = photos[galIdx] || null;
    const brand = Component.BRANDS.find(x=>x.id===s.param);
    const art = Component.NEWS.find(x=>x.id===s.param) || null;
    const MAG_PER = 6;
    const magTotalPages = Math.max(1, Math.ceil(Component.MAGAZINES.length/MAG_PER));
    const magPage = Math.min(Math.max(1, s.magPage||1), magTotalPages);
    const magPageItems = Component.MAGAZINES.slice((magPage-1)*MAG_PER, magPage*MAG_PER);
    const mag = Component.MAGAZINES.find(x=>x.id===s.param) || null;
    // Magazine-pdf: geüpload bestand heeft voorrang op de vaste pdf uit de data (CMS-veld)
    const magUp = mag ? s.magPdfs[mag.id] : null;
    const magPdfUrl = magUp ? magUp.url : (mag && mag.pdf ? mag.pdf : null);
    const magPdfName = magUp ? magUp.name : null;
    const magPdfErr = s.magPdfErr;

    // Jaar/maand-facetten voor Geleverde machines — automatisch uit deliveredAt
    // Geleverde machines: filter op machinecategorie, afgeleid uit de data
    const dAll = Component.DELIVERIES.filter(d=>!d.pubStatus || d.pubStatus==='publish').slice().sort((a,b)=>(a.order||0)-(b.order||0));
    const dCatNames = Array.from(new Set(dAll.map(d=>d.categorie).filter(Boolean))).sort((a,b)=>a.localeCompare(b,'nl'));
    const dCat = (s.dCat && dCatNames.includes(s.dCat)) ? s.dCat : null;
    const dFiltered = dCat ? dAll.filter(d=>d.categorie===dCat) : dAll;
    const D_PER = 20;
    const dTotalPages = Math.max(1, Math.ceil(dFiltered.length/D_PER));
    const dPage = Math.min(Math.max(1, s.dPage||1), dTotalPages);
    const dList = dFiltered.slice((dPage-1)*D_PER, dPage*D_PER);
    const listSrc = page==='occasions' ? Component.publishedOcc() : Component.published();
    const q = s.q.trim().toLowerCase();

    // Interdependent filter options: an option only shows when at least one machine
    // in the current selection (ignoring that facet itself) actually carries it.
    const pool = this.sourceFor();
    const matchQ = m => !q || (m.name+' '+m.brand+' '+m.type).toLowerCase().includes(q);
    const matchStatus = m => !s.fstatus.length || s.fstatus.includes(m.status);
    const typeAvail = new Set(pool.filter(m=>matchQ(m) && matchStatus(m) && (!s.fbrand.length || s.fbrand.includes(m.brand))).map(m=>m.type));
    const brandAvail = new Set(pool.filter(m=>matchQ(m) && matchStatus(m) && (!s.ftype.length || s.ftype.includes(m.type))).map(m=>m.brand));

    const menuCounts = {};
    Component.published().forEach(m=>{ if(m.type) menuCounts[m.type]=(menuCounts[m.type]||0)+1; });
    const menuTypeOpts = Object.keys(menuCounts).sort((a,b)=>menuCounts[b]-menuCounts[a]).slice(0,6)
      .map(name=>({name, quick: ()=>this.nav('machines',null,{ftype:[name]})}));
    // Faceted filtering, volledig afgeleid uit de dataset (later: WordPress/REST).
    // Per facet worden de aantallen berekend over de set waarop alle ANDERE filters
    // al zijn toegepast: OR binnen een groep, AND tussen groepen. Nieuwe merken of
    // machinetypes verschijnen automatisch, opties met 0 resultaten verdwijnen.
    const fullFacets = page==='occasions';
    const facetBase = pool.filter(m=>matchQ(m) && matchStatus(m));
    const tally = (list, key) => list.reduce((o,m)=>{ const v=m[key]; if(v) o[v]=(o[v]||0)+1; return o; }, {});
    const typeCounts  = tally(facetBase.filter(m=>!s.fbrand.length || s.fbrand.includes(m.brand)), 'type');
    const brandCountsF = tally(facetBase.filter(m=>!s.ftype.length  || s.ftype.includes(m.type)),  'brand');
    const byName = (a,b)=>a.localeCompare(b,'nl');

    const typeNames = fullFacets
      ? Array.from(new Set(Object.keys(typeCounts).concat(s.ftype))).sort(byName)
      : Component.TYPES.filter(n=>typeAvail.has(n) || s.ftype.includes(n));
    const typeOpts = typeNames.map(name=>{
      const on = s.ftype.includes(name);
      return {name, active:on,
        countLabel: (fullFacets && typeCounts[name]) ? String(typeCounts[name]) : '',
        bg: on?'#FBAE00':'#ffffff', bc: on?'#FBAE00':'#C9C4BA', chipBg: on?'#FFF6E0':'#ffffff',
        on: ()=>this.toggle('ftype',name),
        quick: ()=>this.nav('machines',null,{ftype:[name]})};
    });
    const allTypesActive = fullFacets && s.ftype.length===0;

    const brandNames = fullFacets
      ? Array.from(new Set(Object.keys(brandCountsF).concat(s.fbrand))).sort(byName)
      : Component.BRANDS.filter(b=>brandAvail.has(b.name) || s.fbrand.includes(b.name)).map(b=>b.name);
    const brandOpts = brandNames.map(name=>{
      const on = s.fbrand.includes(name);
      return {name, active:on,
        countLabel: (fullFacets && brandCountsF[name]) ? String(brandCountsF[name]) : '',
        bg: on?'#FBAE00':'#ffffff', bc: on?'#FBAE00':'#C9C4BA',
        on: ()=>this.toggle('fbrand',name)};
    });
    const brandTypeOpts = brand ? Component.TYPES.filter(n=>typeAvail.has(n) || s.ftype.includes(n)).map(name=>{
      const on = s.ftype.includes(name);
      return {name, bc: on?'#FBAE00':'#C9C4BA', chipBg: on?'#FFF6E0':'#ffffff', on: ()=>this.toggle('ftype',name)};
    }) : [];

    const hourChipLabel = (s.hrMin || s.hrMax) ? ((s.hrMin||'0')+'–'+(s.hrMax||'…')+' uur') : null;
    const chips = [].concat(
      s.ftype.map(t=>({label:t, off: ()=>this.toggle('ftype',t)})),
      s.fbrand.map(b=>({label:b, off: ()=>this.toggle('fbrand',b)})),
      s.fstatus.map(st=>({label:st, off: ()=>this.toggle('fstatus',st)})),
      hourChipLabel ? [{label:hourChipLabel, off: ()=>this.setState({hrMin:'',hrMax:''})}] : []
    );
    const statusOpts = ['Beschikbaar','Gereserveerd','Verkocht'].map(name=>{
      const on = s.fstatus.includes(name);
      return {name, count: Component.OCCASIONS.filter(m=>m.status===name).length,
        bg: on?'#FBAE00':'#ffffff', bc: on?'#FBAE00':'#C9C4BA', on: ()=>this.toggle('fstatus',name)};
    });
    const sortList = page==='occasions' ? Component.SORTS : Component.SORTS_NEW;
    const activeSort = sortList.find(o=>o.v===s.sort) || sortList[0];

    const LIST_PER = 40;
    const listTotalPages = Math.max(1, Math.ceil(res.length/LIST_PER));
    const listPage = Math.min(Math.max(1, s.lpage||1), listTotalPages);
    const listPaged = res.slice((listPage-1)*LIST_PER, listPage*LIST_PER);

    const PER = 10;
    const totalPages = Math.max(1, Math.ceil(res.length/PER));
    const bp = Math.min(Math.max(1, s.bpage||1), totalPages);
    const merkPaged = page==='merk' ? res.slice((bp-1)*PER, bp*PER).map(m=>this.deco(m)) : [];
    const merkPageLinks = Array.from({length:totalPages},(_,i)=>({
      n: String(i+1), active: (i+1)===bp, inactive: (i+1)!==bp,
      go: ()=>this.setState({bpage:i+1})
    }));

    const brandResults = Component.BRANDS.filter(b =>
      (!q || b.name.toLowerCase().includes(q)) &&
      (!s.ftype.length || Component.published().some(m=>m.brand===b.name && s.ftype.includes(m.type)))
    ).map(b=>{
      const n = Component.published().filter(m=>m.brand===b.name).length;
      // Lokaal merklogo (assets/brands/): alleen voor merken zonder al gevuld
      // uploadslot. AS-Motor en BB-Umwelttechnik hebben geen entry in
      // BRAND_LOGOS en blijven dus hun bestaande, correcte logo-slot tonen.
      const logoPath = Component.BRAND_LOGOS[b.id] || null;
      const hasLogo = !!logoPath && !(s.badImgs && s.badImgs[logoPath]);
      return Object.assign({},b,{
        countLabel: n+(n===1?' machine':' machines'),
        open: ()=>this.nav('merk',b.id),
        hasLogo,
        logoFromSlot: !hasLogo,
        logoEl: hasLogo ? this.photoEl({src:logoPath, alt:b.name+' logo'}, b.name+' logo', {fit:'contain'}) : null
      });
    });

    const rentalCat = page==='verhuur' && s.param ? Component.RENTAL.find(c=>c.id===s.param) : null;
    const listTitle = page==='occasions' ? 'Occasions' : rentalCat ? rentalCat.name : page==='verhuur' ? 'Verhuur' : 'Nieuwe machines';
    const listIntro = page==='occasions'
      ? 'Gebruikte machines uit onderhoud en inruil, technisch nagekeken in onze eigen werkplaats. Filter op merk en machinetype.'
      : rentalCat
        ? rentalCat.intro
        : page==='verhuur'
        ? 'Machines huren voor een project, een piek in het seizoen of ter overbrugging. Dezelfde machines, dezelfde service, voor de periode die u nodig heeft.'
        : 'Ons actuele aanbod nieuwe machines voor groen-, berm- en terreinbeheer. Combineer machinetype en merk om direct te zien wat wij leveren.';

    const vacancy = page==='vacature' ? Component.VACANCIES.find(v=>v.id===s.param) : null;
    const br = this._br;
    const brStart = !br || br.scrollLeft <= 2;
    const brEnd = !!br && br.scrollLeft >= br.scrollWidth - br.clientWidth - 2;

    const homeSearchLabel = (s.homeType||s.homeBrand)
      ? 'Bekijk ' + [s.homeType,s.homeBrand].filter(Boolean).join(' · ')
      : 'Bekijk alle machines';

    return {
      transit: s.transit,
      menuAanbod: s.menu==='aanbod',
      mob: s.mob,
      isHome: page==='home',
      isMachines: page==='machines'||page==='occasions',
      isVerhuurHome: page==='verhuur'&&!s.param,
      isRentalCat: page==='verhuur'&&!!s.param,
      rental: rentalCat || {},
      isDetail: page==='detail' && !!detailRaw,
      isMerken: page==='merken',
      isMerk: page==='merk',
      isContact: page==='contact',
      isService: page==='service',
      goServicePage: ()=>this.nav('service'),
      linkIn: (e)=>{ e.currentTarget.style.color='#FBAE00'; },
      linkOut: (e)=>{ e.currentTarget.style.color='#111214'; },
      svGhostIn: (e)=>{ const el=e.currentTarget; el.style.background='#FBAE00'; el.style.color='#111214'; el.style.borderColor='#FBAE00'; },
      svGhostOut: (e)=>{ const el=e.currentTarget; el.style.background='rgba(10,11,13,.28)'; el.style.color='#ffffff'; el.style.borderColor='rgba(255,255,255,.85)'; },
      creditIn: (e)=>{ const el=e.currentTarget; el.style.transform='translateY(-1px)'; el.style.boxShadow='0 0 0 1px rgba(45,224,158,.55)'; },
      creditOut: (e)=>{ const el=e.currentTarget; el.style.transform=''; el.style.boxShadow=''; },
      goContactPage: ()=>this.nav('contact', null, {ctx:null}),
      isSeo: page==='seo',
      isOver: page==='over',
      isNieuws: page==='nieuws',
      isWerken: page==='werken',
      isVacature: page==='vacature',
      isGeleverd: page==='geleverd',
      isMagazines: page==='magazines',
      menuOver: s.menu==='over',
      openOver: ()=>this.setState({menu:'over'}),
      goOver: ()=>this.nav('over'),
      goNieuws: ()=>this.nav('nieuws'),
      goWerken: ()=>this.nav('werken'),
      goGeleverd: ()=>this.nav('geleverd'),
      goMagazines: ()=>this.nav('magazines'),
      news: Component.NEWS.map(n=>Object.assign({},n,{open: ()=>this.nav('nieuwsitem',n.id)})),
      magazines: magPageItems.map(m=>Object.assign({},m,{open: ()=>this.nav('magazine',m.id)})),
      magHasPages: magTotalPages>1,
      magPageLinks: Array.from({length:magTotalPages},(_,i)=>({n:String(i+1), active:(i+1)===magPage, inactive:(i+1)!==magPage, go: ()=>this.setState({magPage:i+1})})),
      magPrevDis: magPage<=1, magNextDis: magPage>=magTotalPages,
      magPrev: ()=>this.setState({magPage:Math.max(1,magPage-1)}),
      magNext: ()=>this.setState({magPage:Math.min(magTotalPages,magPage+1)}),

      isNieuwsItem: page==='nieuwsitem',
      isMagazine: page==='magazine',
      article: art,
      articleBody: (art && art.body) ? art.body.map((t,i)=>({id:'p'+i,t})) : [],
      magazine: mag,
      magHasPdf: !!(mag && magPdfUrl),
      magNoPdf: !!(mag && !magPdfUrl),
      magPdf: magPdfUrl || '#',
      magPdfBtnLabel: magPdfUrl ? 'Vervang pdf' : 'Upload pdf',
      magPdfNote: magPdfErr || (magPdfName ? magPdfName : 'Alleen application/pdf. De cover hierboven blijft een afbeeldingsveld.'),
      magPdfNoteColor: magPdfErr ? '#C00020' : '#7C7770',
      onMagPdf: (e)=>{
        const file = e.target.files && e.target.files[0];
        if(!file) return;
        const okType = file.type === 'application/pdf';
        const okExt = /\.pdf$/i.test(file.name);
        if(!okType || !okExt){
          e.target.value='';
          this.setState({magPdfErr:'Alleen pdf-bestanden zijn toegestaan (application/pdf).'});
          return;
        }
        const prev = this.state.magPdfs[mag.id];
        if(prev && prev.url) URL.revokeObjectURL(prev.url);
        const next = Object.assign({}, this.state.magPdfs);
        next[mag.id] = {url: URL.createObjectURL(file), name: file.name};
        this.setState({magPdfs:next, magPdfErr:null});
      },
      goNieuwsItem: (id)=>this.nav('nieuwsitem',id),

      // Geleverde machines: categoriefilter + paginering (6 per pagina)
      delivCats: [{name:'Alle machines', key:null}].concat(dCatNames.map(n=>({name:n, key:n}))).map(c=>({
        name:c.name,
        bg: dCat===c.key ? '#FBAE00' : '#ffffff',
        bc: dCat===c.key ? '#000000' : '#D9D5CD',
        on: ()=>this.setState({dCat:c.key, dPage:1})
      })),
      delivEmpty: dList.length===0,
      delivCountLabel: dFiltered.length+(dFiltered.length===1?' levering':' leveringen'),
      delivHasPages: dTotalPages>1,
      // Compacte paginering: eerste, laatste en de buren van de actieve pagina,
      // met een ellips waar nummers zijn overgeslagen.
      delivPageLinks: (()=>{
        const keep = new Set([1, dTotalPages, dPage, dPage-1, dPage+1]);
        const out = [];
        for (let i=1; i<=dTotalPages; i++){
          if (keep.has(i)) out.push({n:String(i), active:i===dPage, inactive:i!==dPage, gap:false, go: ()=>this.setState({dPage:i})});
          else if (out.length && !out[out.length-1].gap) out.push({n:'…', active:false, inactive:false, gap:true, go: ()=>{}});
        }
        return out;
      })(),
      delivPrevDis: dPage<=1, delivNextDis: dPage>=dTotalPages,
      delivPrev: ()=>this.setState({dPage:Math.max(1,dPage-1)}),
      delivNext: ()=>this.setState({dPage:Math.min(dTotalPages,dPage+1)}),
      deliveries: dList.map(d=>Object.assign({},d,{
        datum: this.fmtDate(d.deliveredAt),
        hasDatum: !!d.deliveredAt, hasTekst: !!d.tekst,
        hasCategorie: !!d.categorie, hasMerk: !!d.merk,

      })),
      vacancies: Component.VACANCIES.map(v=>Object.assign({},v,{open: ()=>this.nav('vacature',v.id)})),
      vacancyCountLabel: Component.VACANCIES.length + ' openstaande mogelijkheden, inclusief open sollicitatie.',
      vac: vacancy || {},
      vacUrl: vacancy ? 'https://www.wimvanbreda.nl/werken-bij/'+vacancy.id+'/' : '',
      vacSubject: vacancy
        ? (vacancy.id==='open-sollicitatie' ? 'Nieuwe open sollicitatie' : 'Nieuwe sollicitatie – '+vacancy.titel.replace(/^Vacature /,''))
        : 'Nieuwe sollicitatie',
      applyAction: this.props.applyEndpoint || 'https://formspree.io/f/your-jobs-form-id',
      vacImgAlt: vacancy ? vacancy.titel.replace(/^Vacature /,'')+' bij Wim van Breda' : 'Werken bij Wim van Breda',
      // Eigen, lokale foto per vacature — gekoppeld op record-id (vacancy.image/
      // imageAlt), dus onafhankelijk van de volgorde in VACANCIES.
      vacImgEl: (vacancy && vacancy.image) ? this.photoEl({src:vacancy.image, alt:vacancy.imageAlt}, vacancy.imageAlt, {lazy:true, fit:'cover'}) : null,
      // Algemene "Werken bij"-introfoto naast "Echte vakmensen met passie voor deze sector".
      werkenHeroImgEl: this.photoEl({src:'assets/images/werken-bij/werken-bij-intro.jpg'}, 'Luchtfoto van het bedrijfspand van Wim van Breda in Geldermalsen', {lazy:true, fit:'cover'}),
      applyRef: (el)=>{ this._apply = el; },
      applySubmit: this.applySubmit,
      applyOpen: !s.applySent,
      applySent: s.applySent,
      applyBusy: s.applyBusy,
      applyOpacity: s.applyBusy ? 0.6 : 1,
      applyLabel: s.applyBusy ? 'Versturen…' : 'Verstuur sollicitatie',
      applyError: !!s.applyError,
      applyErrorText: s.applyError || '',
      // De video laadt pas na een klik (nooit autoplay bij paginalaad) én pas
      // wanneer marketingcookies zijn toegestaan, conform de bestaande
      // cookiebanner ("marketingcookies plaatsen wij alleen met uw toestemming").
      // Zonder die toestemming toont een klik op afspelen een neutrale
      // toestemmingsvraag in plaats van direct de YouTube-iframe te laden.
      videoOff: !s.videoPlaying,
      videoNeedsConsent: s.videoPlaying && !s.marketing,
      videoOn: s.videoPlaying && s.marketing,
      videoSrc: 'https://www.youtube-nocookie.com/embed/'+this.videoId()+'?autoplay=1&rel=0',
      playVideo: ()=>this.setState({videoPlaying:true}),
      loadVideoConsent: ()=>this.saveConsent(s.analytics,true),
      videoIn:this.videoIn, videoOut:this.videoOut,
      tlRef: (el)=>{ this._tl = el; },
      tlPrev: ()=>this.tlStep(-1),
      tlNext: ()=>this.tlStep(1),
      arrowPrevIn:this.arrowPrevIn, arrowNextIn:this.arrowNextIn, arrowOut:this.arrowOut,
      tlIn:this.tlIn, tlOut:this.tlOut, dragStart:this.dragStart,
      tlPos: String(s.tlActive+1).padStart(2,'0'),
      tlTotal: String(Component.TIMELINE.length).padStart(2,'0'),
      tlAtStart: s.tlActive===0, tlAtEnd: s.tlActive===Component.TIMELINE.length-1,
      tlPrevOpacity: s.tlActive===0 ? 0.32 : 1, tlNextOpacity: s.tlActive===Component.TIMELINE.length-1 ? 0.32 : 1,
      tlPrevCursor: s.tlActive===0 ? 'not-allowed' : 'pointer',
      tlNextCursor: s.tlActive===Component.TIMELINE.length-1 ? 'not-allowed' : 'pointer',
      timeline: Component.TIMELINE.map((e,i)=>{
        const top = i % 2 === 0, on = i === s.tlActive;
        return Object.assign({},e,{
          photoTop: top, textTop: !top,
          scale: on ? 1 : 0.94,
          dot: on ? '#FBAE00' : '#ffffff',
          yearColor: on ? '#111214' : '#9A948A',
          textOpacity: on ? 1 : 0.62,
          select: ()=>this.tlGo(i)
        });
      }),

      hdrRef: (el)=>{ this._hdr = el; },
      logoRef: (el)=>{ this._logo = el; },
      barRef: (el)=>{ this._bar = el; },
      shapeRef: (el)=>{ this._shape = el; },


      showCookie: !s.cookieDecided && !s.prefsOpen,
      prefsOpen: s.prefsOpen,
      openPrefs: ()=>this.setState({prefsOpen:true}),
      closePrefs: ()=>this.setState({prefsOpen:false, cookieDecided: s.cookieDecided}),
      acceptAll: ()=>this.saveConsent(true,true),
      acceptNone: ()=>this.saveConsent(false,false),
      savePrefs: ()=>this.saveConsent(s.analytics,s.marketing),
      toggleAnalytics: ()=>this.setState({analytics:!s.analytics}),
      toggleMarketing: ()=>this.setState({marketing:!s.marketing}),
      analytics: s.analytics, marketing: s.marketing,
