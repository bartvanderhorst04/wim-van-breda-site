  // ---- SEO-herstel: generieke, herbruikbare helpers ---------------------
  // Eindig een title alleen met de merksuffix wanneer dat binnen een
  // bruikbare lengte (~60 tekens) past. Laat anders de suffix weg in
  // plaats van de eigenlijke naam in te korten of te verzinnen.
  static capTitle(base, suffix){
    suffix = suffix || ' | Wim van Breda';
    const full = base + suffix;
    return full.length <= 60 ? full : base;
  }
  // Knip een te lange description uitsluitend bij een echt zin-einde
  // (". ") binnen een bruikbaar bereik, zodat er nooit een afgebroken zin
  // overblijft. Is er geen goed knippunt, dan blijft de tekst ongewijzigd
  // (liever iets te lang dan een afgebroken zin of verzonnen inkorting).
  static capDescription(d){
    if (!d || d.length <= 175) return d;
    const win = d.slice(0, 162);
    const cut = win.lastIndexOf('. ');
    return cut > 80 ? d.slice(0, cut+1) : d;
  }
  // " occasion" wordt alleen toegevoegd als de naam dat woord niet al zelf
  // als laatste woord bevat (hoofdletterongevoelig) — voorkomt "... occasion occasion".
  static occasionTitleBase(displayName){
    return /\boccasion\s*$/i.test(displayName) ? displayName : displayName+' occasion';
  }
  static _dName(m){
    const n = m.name || '';
    if (!m.brand) return n;
    return n.toLowerCase().startsWith(m.brand.toLowerCase()) ? n : (m.brand+' '+n);
  }
  // Twee occasions kunnen hetzelfde model zijn maar wel echt twee losse
  // eenheden op voorraad (zelfde naam, andere specs). Voor iedere titel die
  // op meer dan één occasion voorkomt, wordt hier — uitsluitend op basis
  // van werkelijk aanwezige, tussen die eenheden verschillende specs, in
  // deze vaste volgorde — een echt onderscheidend kenmerk gezocht. Bestaat
  // dat niet (identieke of lege specs), dan blijft het veld leeg: die
  // eenheden zijn dan niet betrouwbaar te onderscheiden.
  static get DUP_OCC_DISTINGUISH(){
    if (!Component._dupOccDist){
      const groups = {};
      Component.publishedOcc().forEach(o=>{
        const key = Component.occasionTitleBase(Component._dName(o)).toLowerCase();
        (groups[key] = groups[key]||[]).push(o);
      });
      const prio = ['bouwjaar','serienummer','afscherming','urenstand','voorraadnummer'];
      const specOf = (o,field)=>{
        const hit = (o.specs||[]).find(s=>String(s.k||'').toLowerCase().replace(/:$/,'')===field);
        return hit ? String(hit.v) : null;
      };
      const map = {};
      Object.keys(groups).forEach(key=>{
        const list = groups[key];
        if (list.length<2) return;
        map[key] = prio.find(f=>{
          const vals = list.map(o=>specOf(o,f));
          return vals.every(v=>v) && new Set(vals).size === list.length;
        }) || null;
      });
      Component._dupOccDist = map;
    }
    return Component._dupOccDist;
  }
  // Een machine en een occasion kunnen precies dezelfde naam, merk en type
  // hebben (zonder kort-tekst) — dan botst hun fallback-description. Alleen
  // in dát specifieke geval (de botsende groep bevat zowel een nieuwe als
  // een occasion-versie) wijkt het slotzinnetje van de occasion-variant af;
  // in alle andere gevallen blijft de bestaande, gedeelde slotzin gelijk.
  static get DUP_FALLBACK_MIXED(){
    if (!Component._dupFallbackMixed){
      const groups = {};
      Component.rentalPool().concat(Component.publishedOcc()).forEach(m=>{
        if (m.kort) return;
        const b = Component._dName(m)+(m.type?' — '+m.type.toLowerCase():'')+'.';
        (groups[b] = groups[b]||[]).push(m);
      });
      const mixed = {};
      Object.keys(groups).forEach(b=>{
        const list = groups[b];
        if (list.length<2) return;
        if (new Set(list.map(m=>m.isOccasion===true)).size>1) mixed[b]=true;
      });
      Component._dupFallbackMixed = mixed;
    }
    return Component._dupFallbackMixed;
  }
  // Kort-teksten die woordelijk identiek zijn tussen twee publiceerbare
  // records leveren via de standaardformule een dubbele meta description
  // op. Eén keer berekend: de set kort-teksten die op meer dan één
  // record voorkomt, zodat die records hun eigen naam als voorvoegsel
  // krijgen (uitsluitend echte, al aanwezige data — niets verzonnen).
  static get DUP_KORTS(){
    if (!Component._dupKorts){
      const seen = {};
      Component.rentalPool().concat(Component.publishedOcc()).forEach(m=>{
        if (m.kort) seen[m.kort] = (seen[m.kort]||0) + 1;
      });
      const dup = {};
      Object.keys(seen).forEach(k=>{ if (seen[k]>1) dup[k]=true; });
      Component._dupKorts = dup;
    }
    return Component._dupKorts;
  }

