  applyMeta(){
    const m = this.meta(); if(!m) return;
    document.title = m.t;
    const set = (sel,attr,val,make)=>{
      let el = document.head.querySelector(sel);
      if(!el){ el = make(); document.head.appendChild(el); }
      el.setAttribute(attr,val);
    };
    set('meta[name="description"]','content',m.d,()=>{const e=document.createElement('meta');e.name='description';return e;});
    set('link[rel="canonical"]','href','https://www.wimvanbreda.nl'+m.u,()=>{const e=document.createElement('link');e.rel='canonical';return e;});
    set('meta[property="og:title"]','content',m.t,()=>{const e=document.createElement('meta');e.setAttribute('property','og:title');return e;});
    set('meta[property="og:description"]','content',m.d,()=>{const e=document.createElement('meta');e.setAttribute('property','og:description');return e;});
    set('meta[property="og:url"]','content','https://www.wimvanbreda.nl'+m.u,()=>{const e=document.createElement('meta');e.setAttribute('property','og:url');return e;});
    set('meta[name="robots"]','content',this.state.page==='seo'?'noindex,follow':'index,follow',()=>{const e=document.createElement('meta');e.name='robots';return e;});
    this.applyJsonLd(m);
