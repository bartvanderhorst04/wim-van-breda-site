          this.nav('contact');
        }
      },
      goService: ()=>this.contactWith('Service & reparatie','service','/service/'),
      ctxActive: !!s.ctx,
      ctxTitle: s.ctx ? s.ctx.title : '',
      ctxType: s.ctx ? s.ctx.type : '',
