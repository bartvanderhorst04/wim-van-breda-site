    const f = file && file.files && file.files[0];
    if (!f) return this.setState({applyError:'Voeg uw cv toe als PDF of DOCX.'});
    const ok = /\.(pdf|docx?)$/i.test(f.name);
    if (!ok) return this.setState({applyError:'Alleen PDF- of DOCX-bestanden zijn toegestaan.'});
    if (f.size > 10*1024*1024) return this.setState({applyError:'Het bestand is groter dan 10 MB. Verklein het cv en probeer het opnieuw.'});
    if (!form.checkValidity()) return this.setState({applyError:'Vul alle verplichte velden in.'});
    this.setState({applyBusy:true, applyError:null});
    const data = new FormData(form);
    fetch(form.getAttribute('action'), {method:'POST', body:data, headers:{Accept:'application/json'}})
      .then(r => r.ok ? r : Promise.reject(new Error('mislukt')))
      .then(()=>this.setState({applyBusy:false, applySent:true}))
      .catch(()=>this.setState({applyBusy:false, applyError:'Versturen is niet gelukt. Probeer het opnieuw of mail uw sollicitatie naar johandeleeuw@wimvanbreda.nl.'}));
