  // Alleen gepubliceerde machines zijn publiek zichtbaar; concept en privé blijven in de dataset
  // Eén lookup voor alle detailpagina's. De collectie volgt uit de id-namespace
  // (occasions dragen het prefix 'occ-'), zodat titel, canonical, breadcrumbs,
  // schema en beeldslots gegarandeerd uit hetzelfde record komen.
  findItem(id){
    if (!id) return null;
    return String(id).indexOf('occ-') === 0
      ? Component.publishedOcc().find(x=>x.id===id) || null
      : Component.rentalPool().find(x=>x.id===id) || null;
  }

  // Bewaakt de aanname bij toekomstige imports: ids moeten uniek zijn over de
  // hele catalogus, anders delen twee records hun uploadslot en detailroute.
  static assertUniqueIds(){
    const seen = {}, clash = [];
    [['machine',Component.MACHINES],['occasion',Component.OCCASIONS],['merk',Component.BRANDS]].forEach(([coll,list])=>{
      list.forEach(m=>{
        if (seen[m.id]) clash.push(m.id+' ('+seen[m.id]+' + '+coll+')');
        else seen[m.id] = coll;
      });
    });
    if (clash.length) console.warn('[data] dubbele id over collecties:', clash.join(', '));
    return clash;
  }

  // Publiek machineaanbod. rentalOnly-machines horen alleen bij Verhuur en blijven
  // buiten Nieuwe machines, merkpagina's, filters en tellingen.
  static published(){ return Component.MACHINES.filter(m=>(!m.pubStatus || m.pubStatus==='publish') && !m.rentalOnly); }
  static rentalPool(){ return Component.MACHINES.filter(m=>!m.pubStatus || m.pubStatus==='publish'); }
  static publishedOcc(){ return Component.OCCASIONS.filter(m=>!m.pubStatus || m.pubStatus==='publish'); }

  sourceFor(){
    const {page,param} = this.state;
    if (page==='occasions') return Component.publishedOcc();
    if (page==='merk'){ const b=Component.BRANDS.find(x=>x.id===param); return Component.published().filter(m=>b&&m.brand===b.name); }
    if (page==='verhuur'){
      const ids = Component.RENTAL_ITEMS[param];
      const pick = ids || Object.keys(Component.RENTAL_ITEMS).reduce((a,k)=>a.concat(Component.RENTAL_ITEMS[k]),[]);
      const seen = {};
      return pick.map(id=>Component.rentalPool().find(m=>m.id===id))
        .filter(m=>m && !seen[m.id] && (seen[m.id]=true));
    }
    return Component.published();
  }

  results(){
    const {q,ftype,fbrand,sort,page,fstatus,hrMin,hrMax} = this.state;
    const src = this.sourceFor();
    const needle = q.trim().toLowerCase();
    let out = src.filter(m =>
      (!ftype.length || ftype.includes(m.type)) &&
      (!fbrand.length || fbrand.includes(m.brand)) &&
      (!needle || (m.name+' '+m.brand+' '+m.type).toLowerCase().includes(needle)));
    if (page==='occasions'){
      const hMin = parseInt(hrMin,10), hMax = parseInt(hrMax,10);
      out = out.filter(m=>{
        if (fstatus.length && !fstatus.includes(m.status)) return false;
        if (m.urenNum != null){
          if (!isNaN(hMin) && m.urenNum < hMin) return false;
          if (!isNaN(hMax) && m.urenNum > hMax) return false;
        }
        return true;
      });
    }
    const num = (v,fb)=> v==null ? fb : v;
    const s = out.slice();
    switch(sort){
      case 'nieuwste': s.sort((a,b)=>String(b.toegevoegd||'').localeCompare(String(a.toegevoegd||''))); break;
      case 'oudste': s.sort((a,b)=>String(a.toegevoegd||'').localeCompare(String(b.toegevoegd||''))); break;
      case 'jaar-nieuw': s.sort((a,b)=>(parseInt(b.bouwjaar,10)||0)-(parseInt(a.bouwjaar,10)||0)); break;
      case 'jaar-oud': s.sort((a,b)=>(parseInt(a.bouwjaar,10)||9999)-(parseInt(b.bouwjaar,10)||9999)); break;
      case 'uren-laag': s.sort((a,b)=>num(a.urenNum,Infinity)-num(b.urenNum,Infinity)); break;
      case 'uren-hoog': s.sort((a,b)=>num(b.urenNum,-1)-num(a.urenNum,-1)); break;
      case 'naam': s.sort((a,b)=>a.name.localeCompare(b.name,'nl')); break;
      case 'naam-desc': s.sort((a,b)=>b.name.localeCompare(a.name,'nl')); break;
      case 'merk': s.sort((a,b)=>a.brand.localeCompare(b.brand,'nl')); break;
      case 'merk-desc': s.sort((a,b)=>b.brand.localeCompare(a.brand,'nl')); break;
    }
    return s;
  }

  deco(m,rentalFrom){
    const isOcc = m.isOccasion === true;
    // Kaartafbeelding: de eerste foto uit MACHINE_IMAGES (machine-images.js) telt
    // als hoofd- én kaartafbeelding. Ontbreekt die foto, dan valt de kaart terug
    // op het lege image-slot-vlak, precies zoals de galerij op de detailpagina.
    const cardPhoto = this.livePhotos(m)[0] || null;
    const cardHasPhoto = !!(cardPhoto && cardPhoto.src);
    return Object.assign({},m,{
      isOcc,
      cardFromData: cardHasPhoto,
      cardFromSlot: !cardHasPhoto,
      cardImgEl: this.photoEl(cardPhoto, m.name, {lazy:true, fit:'natural', maxHeight:'420px'}),
      // Uitsluitend voor de machine-/occasion-overzichtspagina's en merkpagina:
      // vult een vaste kaderhoogte, zonder bijsnijden (fit:'contain'), zodat alle
      // kaarten exact dezelfde afmetingen krijgen. "Gerelateerd" blijft cardImgEl
      // (natuurlijke hoogte) gebruiken en is dus onveranderd.
      cardImgElFixed: this.photoEl(cardPhoto, m.name, {lazy:true, fit:'contain'}),
      // Uitsluitend voor "Machines uit ons aanbod" op de homepage: vult het vaste
      // 3:2-vlak volledig, bijsnijden toegestaan (fit:'cover') — dit zijn
      // sfeervolle actiefoto's met een volledige achtergrond.
      cardImgElCover: this.photoEl(cardPhoto, m.name, {lazy:true, fit:'cover'}),
      typeLabel: (m.type && m.type.toLowerCase() !== (m.name||'').toLowerCase()) ? m.type : '',
      badge: isOcc ? 'Occasion' : 'Nieuw',
      kort: m.kort || '',
      hasKort: !!m.kort, hasTekst: !!m.tekst,
      hasSpecs: !!(m.specs && m.specs.length),
      hasKenmerken: !!(m.kenmerken && m.kenmerken.length),
      hasToepassingen: !!(m.toepassingen && m.toepassingen.length),
      hasImg: !!m.img,
      hasType: !!(m.type && m.type.toLowerCase() !== (m.name||'').toLowerCase()),
      hasOccStatus: !!m.occStatus,
      hasBouwjaar: !!m.bouwjaar, hasUren: !!m.uren,
      statusDot: m.status==='Beschikbaar' ? '#4A7A3A' : (m.status==='Gereserveerd' ? '#FBAE00' : '#C00020'),
      // Occasionpagina's tonen uitsluitend echte, brongebonden inhoud: de generieke
