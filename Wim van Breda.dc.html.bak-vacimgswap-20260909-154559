  // Foto's waarvan het bestand aantoonbaar niet laadt vallen uit de galerij:
  // teller, thumbnails en de "Fotografie volgt"-fallback rekenen daarop mee.
  livePhotos(m){
    const bad = this.state.badImgs || {};
    return this.photosFor(m).filter(p => !(p && p.src && bad[p.src]));
  }

  markBadImg(src){
    if (!src) return;
    this.setState(st => {
      const bad = Object.assign({}, st.badImgs);
      if (bad[src]) return null;
      bad[src] = true;
      return {badImgs: bad};
    });
  }

  // fit: 'cover' (vult het vak, bijsnijden toegestaan — bv. thumbnails) |
  //      'contain' (vult een vak met VASTE afmetingen, geen bijsnijden — bv.
  //      de lightbox) |
  //      'natural' (geen vast vak: volle breedte, hoogte volgt de eigen
  //      beeldverhouding — bv. de hoofdgalerij en de kaarten). De CSS
  //      aspect-ratio hieronder is uitsluitend een laad-placeholder: zodra de
  //      afbeelding zelf laadt, neemt de browser automatisch diens eigen,
  //      werkelijke beeldverhouding over (CSS Sizing-spec-gedrag) — dit
  //      voorkomt een layout-vak van 0px hoogte, waardoor native lazy-loading
  //      anders nooit ziet dat de afbeelding in beeld komt en niet laadt.
  photoEl(p, alt, opts){
    if (!p || !p.src) return null;
    const o = opts || {};
    const fit = o.fit || 'cover';
    const sizing = fit === 'natural'
      ? Object.assign({width:'100%',height:'auto',maxWidth:'100%',aspectRatio:'auto 4 / 3'}, o.maxHeight ? {maxHeight:o.maxHeight} : null)
      : {width:'100%',height:'100%'};
    return React.createElement('img', {
      src: p.src, alt: p.alt || alt || '',
      loading: o.lazy ? 'lazy' : 'eager',
      fetchPriority: o.priority || 'auto',
      onError: () => this.markBadImg(p.src),
      style: Object.assign({display:'block',objectFit: fit==='cover' ? 'cover' : 'contain',objectPosition:'center'}, sizing)
    });
  }

  // Aantal bannerposities per machine. Data uit machine-images.js wint; anders
  // bepaalt de gebruiker het aantal met + / − (minimaal 1), bewaard in localStorage.
  slotCountFor(m){
    if (!m) return 1;
    const data = this.livePhotos(m);
    if (data.length) return data.length;
    const n = (this.state.galSlots || {})[m.id];
    return Math.max(1, n || 1);
  }

  setSlotCount(id, n){
    this.setState(st => {
      const map = Object.assign({}, st.galSlots);
      map[id] = Math.max(1, n);
      try { localStorage.setItem('wvb-gal-slots', JSON.stringify(map)); } catch(e){}
      return {galSlots: map, gallery: Math.min(st.gallery, map[id]-1)};
    });
  }

  galCountFor(m){ return this.slotCountFor(m); }

  // Vragenlijst boven de footer: verstuurt op de achtergrond naar Formspree,
  // met paginacontext (titel + URL) zodat duidelijk is waar de vraag vandaan komt.
  wizardSend(){
    const s = this.state;
    if (s.qBusy) return;
    const endpoint = (s.ctx && s.ctx.type==='service')
      ? (this.props.serviceEndpoint || 'https://formspree.io/f/your-service-form-id')
      : (this.props.formspreeEndpoint || 'https://formspree.io/f/your-form-id');
    const cur = Component.rentalPool().find(x=>x.id===s.param) || Component.publishedOcc().find(x=>x.id===s.param);
    const m = this.meta();
    const pageTitle = cur ? this.displayName(cur) : (m ? m.t : document.title);
    const data = new FormData();
    data.append('onderwerp', s.qTopic || 'Anders');
    data.append('verzoek', s.qMsg || '');
    data.append('naam', s.qName || '');
    data.append('contactgegevens', s.qContact || '');
    if (/@/.test(s.qContact||'')) data.append('_replyto', s.qContact);
    data.append('pagina_titel', pageTitle);
    data.append('pagina_url', (m && m.u) || location.pathname);
    data.append('_subject', 'Nieuwe aanvraag – ' + (s.qTopic || 'Anders') + ' – ' + pageTitle);
    this.setState({qBusy:true, qError:null});
    fetch(endpoint, {method:'POST', body:data, headers:{Accept:'application/json'}})
      .then(r => { if(!r.ok) throw new Error('mislukt'); this.setState({qBusy:false, qStep:4}); })
      .catch(() => this.setState({qBusy:false, qError:'Verzenden is niet gelukt. Probeer het opnieuw of bel ons op +31(0)345 58 50 50.'}));
  }

