<style>
:root{--wvb-primary:#FBAE00;--wvb-on-yellow:#E1021D;--wvb-accent-line:#C00020;--wvb-ink:#111214;--wvb-ease:cubic-bezier(.2,.7,.3,1);--wvb-dur:200ms}
html{scroll-behavior:smooth}
/* Lenis smooth scroll (motion.js) — required base styles from lenis.css */
html.lenis,html.lenis body{height:auto}
.lenis:not(.lenis-autoToggle).lenis-stopped{overflow:clip}
.lenis [data-lenis-prevent],.lenis [data-lenis-prevent-wheel],.lenis [data-lenis-prevent-touch],.lenis [data-lenis-prevent-vertical],.lenis [data-lenis-prevent-horizontal]{overscroll-behavior:contain}
.lenis.lenis-smooth iframe{pointer-events:none}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:#FCFCFB;-webkit-font-smoothing:antialiased;font-family:'IBM Plex Sans',system-ui,sans-serif;color:#111214}
*{box-sizing:border-box}
button,input,select,textarea{font-family:inherit}
a{color:#111214;text-decoration:none}
a{transition:color var(--wvb-dur) ease}
a:hover{color:var(--wvb-primary)}
:focus-visible{outline:2px solid #FBAE00;outline-offset:3px}
::selection{background:#FBAE00;color:#111214}
@keyframes wvbLayer{0%{opacity:0}12%{opacity:1}72%{opacity:1}100%{opacity:0}}
@keyframes wvbDrive{0%{transform:translateX(-14vw) translateY(0)}25%{transform:translateX(18vw) translateY(-3px)}50%{transform:translateX(50vw) translateY(0)}75%{transform:translateX(82vw) translateY(-3px)}100%{transform:translateX(116vw) translateY(0)}}
@keyframes wvbTrail{0%{transform:scaleX(0)}100%{transform:scaleX(1)}}
@keyframes wvbDrawer{0%{opacity:0;transform:translateY(-8px)}100%{opacity:1;transform:translateY(0)}}
@keyframes wvbZoom{0%{transform:scale(1.12)}100%{transform:scale(1.005)}}
@keyframes wvbGlow{0%{opacity:0}100%{opacity:1}}
@keyframes wvbRise{0%{opacity:0;transform:translateY(22px)}100%{opacity:1;transform:translateY(0)}}
@keyframes wvbLine{0%{transform:scaleX(0)}100%{transform:scaleX(1)}}
@keyframes wvbBob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}
@keyframes wvbSwap{0%{opacity:0;transform:translateX(10px)}100%{opacity:1;transform:translateX(0)}}
@keyframes wvbUp{0%{opacity:0;transform:translateY(30px)}100%{opacity:1;transform:translateY(0)}}
[data-mask-reveal]{opacity:1}
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
    [data-mask-reveal]{animation:wvbMaskReveal 1 linear both;animation-timeline:view();animation-range:entry 0% entry 70%}
  }
}
@keyframes wvbMaskReveal{0%{clip-path:inset(22% 33% round 8px)}100%{clip-path:inset(0% 0% round 0px)}}
[data-tlscroll]{scrollbar-width:none;-ms-overflow-style:none;cursor:grab;scroll-behavior:auto!important}
[data-tlscroll]::-webkit-scrollbar{display:none;width:0;height:0}
[data-tlscroll][data-dragging]{cursor:grabbing;scroll-behavior:auto}
@media (max-width:1000px){[data-brandteaser]{grid-template-columns:1fr 1fr!important}}
