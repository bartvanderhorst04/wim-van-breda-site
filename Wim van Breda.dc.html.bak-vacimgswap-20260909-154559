      homeTypeVal: s.homeType, homeBrandVal: s.homeBrand,
      typeOpts, brandOpts, brandTypeOpts, chips,
      hasChips: chips.length>0,
      clearFilters: ()=>this.setState({ftype:[],fbrand:[],fstatus:[],hrMin:'',hrMax:'',q:'',lpage:1,bpage:1}),
      isOccList: page==='occasions',
      allTypesActive,
      allTypesBg: allTypesActive?'#FBAE00':'#ffffff',
      allTypesBc: allTypesActive?'#FBAE00':'#C9C4BA',
      resetTypes: ()=>this.setState({ftype:[], bpage:1, lpage:1}),
      occTypeTotal: String(Component.publishedOcc().length),
      statusOpts,
      setHrMin: (e)=>this.setState({hrMin:e.target.value}),
      setHrMax: (e)=>this.setState({hrMax:e.target.value}),
      sortOpen: s.sortOpen,
      toggleSort: ()=>this.setState({sortOpen:!s.sortOpen}),
      closeSort: ()=>this.setState({sortOpen:false}),
