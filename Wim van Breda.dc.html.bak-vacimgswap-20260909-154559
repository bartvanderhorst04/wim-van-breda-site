      brands: Component.BRANDS.map(b=>Object.assign({},b,{open:()=>this.nav('merk',b.id)})),
      brRef: (el)=>{ this._br = el; },
      brDragStart: this.brDragStart,
      brandIn: this.brandIn, brandOut: this.brandOut,
      brPrev: ()=>this.brStep(-1), brNext: ()=>this.brStep(1),
      brAtStart: brStart, brAtEnd: brEnd,
      brPrevOpacity: brStart ? 0.32 : 1, brNextOpacity: brEnd ? 0.32 : 1,
      brPrevCursor: brStart ? 'not-allowed' : 'pointer', brNextCursor: brEnd ? 'not-allowed' : 'pointer',
