  // Structured data: één Organization per document, plus Product + BreadcrumbList op detailpagina's.
  applyJsonLd(m){
    const BASE = 'https://www.wimvanbreda.nl';
    const put = (id,obj)=>{
      let el = document.head.querySelector('script[data-ld="'+id+'"]');
      if(!obj){ if(el) el.remove(); return; }
      if(!el){ el = document.createElement('script'); el.type='application/ld+json'; el.setAttribute('data-ld',id); document.head.appendChild(el); }
      el.textContent = JSON.stringify(obj);
    };

    put('org',{'@context':'https://schema.org','@type':'Organization',name:'Wim van Breda B.V.',url:BASE,
      address:{'@type':'PostalAddress',streetAddress:'Oudenhof 14',postalCode:'4191 NW',addressLocality:'Geldermalsen',addressCountry:'NL'},
      telephone:'+31345585050'});

    const {page,param} = this.state;
    if(page!=='detail'){ put('product',null); put('crumbs',null); return; }

    const d = this.findItem(param);
    if(!d){ put('product',null); put('crumbs',null); return; }

    const isOcc = d.isOccasion===true;
    // Moet naar een URL wijzen die daadwerkelijk als route bestaat: de
    // overzichtspagina's zijn /machines/ en /occasions/ (zie meta()).
    const parentUrl = isOcc ? '/occasions/' : '/machines/';
    const parentName = isOcc ? 'Occasions' : 'Nieuwe machines';

    // Uitsluitend velden die daadwerkelijk in de data staan — geen prijzen, reviews of voorraad.
    const fullName = this.displayName(d);
    const desc = d.kort || d.tekst || (fullName+(d.type?' — '+d.type.toLowerCase():'')+'. Verkrijgbaar bij Wim van Breda in Geldermalsen.');
    const product = {'@context':'https://schema.org','@type':'Product',
      name: fullName, description: desc,
      url: BASE+m.u,
      brand:{'@type':'Brand',name:d.brand}};
    if (d.type) product.category = d.type;
    if(d.model) product.model = d.model;
    put('product',product);

    // Geen categorie-stap: er bestaat geen werkende categorieroute (filteren
    // op type gebeurt uitsluitend clientside op /machines/ en /occasions/),
