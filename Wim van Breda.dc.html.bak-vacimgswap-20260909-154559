image-slot[data-shot]:hover::part(empty){opacity:1}
image-slot[data-logo]:hover::part(empty){opacity:1}
@media (max-width:1180px){[data-hdrinner]{padding:0 24px!important;gap:20px!important}[data-hdrinner] nav[data-desk]{gap:0!important}}
