      mktBg: s.marketing?'#FBAE00':'#F1EFEA', mktBorder: s.marketing?'#FBAE00':'#D9D5CD', mktX: s.marketing?'29px':'3px',

      skewIn:this.skewIn, skewOut:this.skewOut, ghostIn:this.ghostIn, ghostOut:this.ghostOut,

